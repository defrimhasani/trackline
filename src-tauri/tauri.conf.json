{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trackline",
  "version": "0.1.0",
  "identifier": "com.trackline.timesheet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Trackline", "width": 1440, "height": 900, "minWidth": 760, "minHeight": 560, "resizable": true }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all" }
}
